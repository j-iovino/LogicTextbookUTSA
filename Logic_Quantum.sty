% ─── Theorem environments (thmtools; numberlike=theorem shares the counter through aliascnt) ───
\declaretheoremstyle[name=Theorem,]{thmsty}
\declaretheorem[style=thmsty,numberwithin=section]{theorem}
\tcolorboxenvironment{theorem}
{colback=LightPurple}

\declaretheoremstyle[name=Proposition,]{prosty}
\declaretheorem[style=prosty,numberlike=theorem]{proposition}
\tcolorboxenvironment{proposition}
{colback=LightPurple}

\declaretheoremstyle[name=Corollary,]{prosty}
\declaretheorem[style=prosty,numberlike=theorem]{corollary}
\tcolorboxenvironment{corollary}
{colback=LightPurple}

\declaretheoremstyle[name=Claim,]{prosty}
\declaretheorem[style=prosty,numberlike=theorem]{claim}
\tcolorboxenvironment{claim}
{colback=LightPurple}

\declaretheoremstyle[name=Lemma,]{lemsty}
\declaretheorem[style=lemsty,numberlike=theorem]{lemma}
\tcolorboxenvironment{lemma}
{colback=LightPurple}

\declaretheoremstyle[name=Definition,]{defnsty}
\declaretheorem[style=defnsty,numberlike=theorem]{definition}
\tcolorboxenvironment{definition}
{colback=LightPink}

\declaretheoremstyle[name=Notation,]{nosty}
\declaretheorem[style=nosty,numberlike=theorem]{notation}
\tcolorboxenvironment{notation} 
{colback=LightBlue}

\declaretheoremstyle[name=Historical note,]{nosty}
\declaretheorem[style=nosty, numbered=no]{history}
\tcolorboxenvironment{history} 
{colback=LightGreen}

\declaretheoremstyle[name=Example,]{exsty}
\declaretheorem[style=exsty,numberlike=theorem]{example}

\declaretheoremstyle[name=Examples,]{exsty}
\declaretheorem[style=exsty,numberlike=theorem]{examples}

\declaretheoremstyle[name=Remark,]{exsty}
